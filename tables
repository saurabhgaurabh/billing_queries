CREATE TABLE r_enum_values (
    enum_id INT ,
    enum_code VARCHAR(50),
    enum_value VARCHAR(140),
    is_active TINYINT DEFAULT 1,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
	primary key(enum_id,enum_code)
);

CREATE TABLE users (
    user_id INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(100),
    mobile varchar(15),
    email VARCHAR(100) UNIQUE,
    password VARCHAR(255),
    role_id int,
    otp int,
    secret longtext,
    flag TINYINT DEFAULT 0,
    status TINYINT DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

create table users_audit (
    user_audit_id int PRIMARY KEY AUTO_INCREMENT,
    deleted_user_id int,
    deleted_username VARCHAR(100),
    deleted_mobile varchar(15),
    deleted_email VARCHAR(100) UNIQUE,
    deleted_role_id int,
    deleted_status TINYINT DEFAULT 0,
    deleted_by_user_id int,
    created_at    DATETIME,
    deleted_at    DATETIME     NOT NULL,
    deleted_by    VARCHAR(100) NOT NULL
);

CREATE TRIGGER after_delete_user 
AFTER DELETE ON users 
FOR EACH ROW 
BEGIN 
INSERT INTO users_audit ( deleted_user_id, deleted_username, deleted_mobile, deleted_email, deleted_role_id,
deleted_status, deleted_by_user_id, created_at, deleted_at, deleted_by ) VALUES (
OLD.user_id, OLD.username, OLD.mobile, OLD.email, OLD.role_id, OLD.status, OLD.user_id, NOW(), NOW(), OLD.user_id
);
END;

                                 --  item group
CREATE TABLE item_groups (
    group_id INT AUTO_INCREMENT PRIMARY KEY,
    group_name VARCHAR(100)
);

                               --  manage HSN/SAC codes in items
CREATE TABLE items (
    item_id INT AUTO_INCREMENT PRIMARY KEY,
    group_id INT,
    item_name VARCHAR(150),
    sku VARCHAR(50),
    item_type int,   /* mapped with r_enum_values */
    hsn_code VARCHAR(10),
    sac_code VARCHAR(10),
    gst_percent DECIMAL(5,2),
    min_stock INT DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (group_id) REFERENCES item_groups(group_id)
);

                                              --  vendors
CREATE TABLE vender (
    vendor_id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(150),
    mobile varchar(15),
    email varchar(40),
    gstin VARCHAR(20),
    phone VARCHAR(20),
    address TEXT,    
    state VARCHAR(100)
