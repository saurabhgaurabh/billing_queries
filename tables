                                                   --  Customer   ---

CREATE TABLE customer (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(150),
    mobile varchar(15),
    email varchar(40),
    document_id VARCHAR(20),
    phone VARCHAR(20),
    address TEXT,
