-- sales summery --

SELECT 
    s.invoice_no,
    s.sale_date,
    p.name AS customer_name,
    s.subtotal,
    s.cgst,
    s.sgst,
    s.igst,
    s.grand_total
FROM sales s
JOIN parties p ON p.party_id = s.customer_id
WHERE s.sale_date BETWEEN '2026-05-01' AND '2026-05-31';

--  Query: Tax Summary (GSTR-1)

SELECT 
    SUM(subtotal) AS taxable_value,
    SUM(cgst) AS total_cgst,
    SUM(sgst) AS total_sgst,
    SUM(igst) AS total_igst,
    SUM(grand_total) AS total_invoice_value
FROM sales
WHERE sale_date BETWEEN '2026-05-01' AND '2026-05-31';


--- Query: HSN-wise Sales Report

SELECT 
    si.hsn_sac_code,
    SUM(si.quantity) AS total_qty,
    SUM(si.total) AS taxable_value,
    SUM(si.cgst) AS cgst,
    SUM(si.sgst) AS sgst,
    SUM(si.igst) AS igst
FROM sale_items si
JOIN sales s ON s.sale_id = si.sale_id
WHERE s.sale_date BETWEEN '2026-05-01' AND '2026-05-31'
GROUP BY si.hsn_sac_code;

--  GSTR-2 (Purchase Report –  What you purchased)


SELECT 
    pu.bill_no,
    pu.purchase_date,
    pa.name AS vendor_name,
    pu.subtotal,
    pu.tax_total,
    pu.grand_total
FROM purchases pu
JOIN parties pa ON pa.party_id = pu.vendor_id
WHERE pu.purchase_date BETWEEN '2026-05-01' AND '2026-05-31';


--- Query: ITC Summary  ---

SELECT 
    SUM(pi.total) AS taxable_value,
    SUM(pi.gst_amount) AS total_itc
FROM purchase_items pi
JOIN purchases pu ON pu.purchase_id = pi.purchase_id
WHERE pu.purchase_date BETWEEN '2026-05-01' AND '2026-05-31';


-- Query: HSN-wise Purchase Report -- 
SELECT 
    i.hsn_code,
    SUM(pi.quantity) AS total_qty,
    SUM(pi.total) AS taxable_value,
    SUM(pi.gst_amount) AS total_tax
FROM purchase_items pi
JOIN items i ON i.item_id = pi.item_id
JOIN purchases pu ON pu.purchase_id = pi.purchase_id
WHERE pu.purchase_date BETWEEN '2026-05-01' AND '2026-05-31'
GROUP BY i.hsn_code;


-- GSTR-3B (Final GST Payable) -- GST Payable = Output Tax - Input Tax

SELECT 
    sales_tax.total_output_tax,
    purchase_tax.total_input_tax,
    (sales_tax.total_output_tax - purchase_tax.total_input_tax) AS gst_payable
FROM 
(
    SELECT 
        SUM(cgst + sgst + igst) AS total_output_tax
    FROM sales
    WHERE sale_date BETWEEN '2026-05-01' AND '2026-05-31'
) AS sales_tax,
(
    SELECT 
        SUM(gst_amount) AS total_input_tax
    FROM purchase_items pi
    JOIN purchases pu ON pu.purchase_id = pi.purchase_id
    WHERE pu.purchase_date BETWEEN '2026-05-01' AND '2026-05-31'
) AS purchase_tax;



-- B2B vs B2C Sales (Important for GST Filing) --

SELECT 
    CASE 
        WHEN p.gstin IS NOT NULL THEN 'B2B'
        ELSE 'B2C'
    END AS sale_type,
    COUNT(*) AS total_invoices,
    SUM(s.grand_total) AS total_value
FROM sales s
JOIN parties p ON p.party_id = s.customer_id
GROUP BY sale_type;


-- State-wise GST Report -- 

SELECT 
    p.state,
    SUM(s.grand_total) AS total_sales,
    SUM(s.igst) AS igst,
    SUM(s.cgst) AS cgst,
    SUM(s.sgst) AS sgst
FROM sales s
JOIN parties p ON p.party_id = s.customer_id
GROUP BY p.state;


-- Pending Payments Report -- 
SELECT 
    invoice_no,
    grand_total,
    status
FROM sales
WHERE status != 'PAID';


-- Payment vs Invoice Matching --

SELECT 
    s.invoice_no,
    s.grand_total,
    IFNULL(SUM(p.amount), 0) AS paid_amount,
    (s.grand_total - IFNULL(SUM(p.amount), 0)) AS balance
FROM sales s
LEFT JOIN payments p 
    ON p.reference_id = s.sale_id 
    AND p.reference_type = 'SALE'
GROUP BY s.sale_id;

