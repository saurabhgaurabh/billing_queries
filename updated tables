////////////////////////////////////////////////////////////////////
CREATE TABLE customers (
    customer_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,

    -- Basic Information
    name VARCHAR(150) NOT NULL,
    company_name VARCHAR(150) NULL,

    -- Contact Information
    mobile VARCHAR(15) NULL,
    phone VARCHAR(20) NULL,
    email VARCHAR(150) NULL,
    amount decimal(10,2),

    -- GST / Tax / Identity
    gstin VARCHAR(15) NULL,
    pan VARCHAR(10) NULL,
    document_id VARCHAR(50) NULL,

    -- Address
    address_line1 VARCHAR(255) NULL,
    address_line2 VARCHAR(255) NULL,
    city VARCHAR(100) NULL,
    state VARCHAR(100) NULL,
    state_code VARCHAR(2) NULL,
    country VARCHAR(100) NOT NULL DEFAULT 'India',
    pincode VARCHAR(10) NULL,

    -- Financial Information
    opening_balance DECIMAL(15,2) NOT NULL DEFAULT 0.00,
    credit_limit DECIMAL(15,2) NOT NULL DEFAULT 0.00,
    credit_days SMALLINT UNSIGNED NOT NULL DEFAULT 0,

    -- Status
    status TINYINT(1) NOT NULL DEFAULT 1,

    -- Additional Information
    notes TEXT NULL,

    -- Timestamps
    created_at TIMESTAMP NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NULL DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    -- Indexes
    INDEX idx_customer_name (name),
    INDEX idx_customer_mobile (mobile),
    INDEX idx_customer_gstin (gstin),
    INDEX idx_customer_pan (pan),
    INDEX idx_customer_status (status)
);

//////////////////////////////////////////////// end customers//////////////


//// start venders table //////////////
CREATE TABLE vendors (
    vendor_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,

    -- Basic Information
    name VARCHAR(150) NOT NULL,
    company_name VARCHAR(150) NULL,

    -- Contact Information
    mobile VARCHAR(15) NULL,
    phone VARCHAR(20) NULL,
    email VARCHAR(150) NULL,

    -- GST / Tax Information
    gstin VARCHAR(15) NULL,
    pan VARCHAR(10) NULL,

    -- Address
    address_line1 VARCHAR(255) NULL,
    address_line2 VARCHAR(255) NULL,
    city VARCHAR(100) NULL,
    state VARCHAR(100) NULL,
    state_code VARCHAR(2) NULL,
    country VARCHAR(100) NOT NULL DEFAULT 'India',
    pincode VARCHAR(10) NULL,

    -- Financial Information
    opening_balance DECIMAL(15,2) NOT NULL DEFAULT 0.00,
    credit_limit DECIMAL(15,2) NOT NULL DEFAULT 0.00,
    credit_days SMALLINT UNSIGNED NOT NULL DEFAULT 0,

    -- Status
    status TINYINT(1) NOT NULL DEFAULT 1,

    -- Additional Information
    notes TEXT NULL,

    -- Timestamps
    created_at TIMESTAMP NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NULL DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    -- Indexes
    INDEX idx_vendor_name (name),
    INDEX idx_vendor_mobile (mobile),
    INDEX idx_vendor_gstin (gstin),
    INDEX idx_vendor_pan (pan),
    INDEX idx_vendor_status (status)
);

                               --  items table
CREATE TABLE items (
    item_id INT AUTO_INCREMENT PRIMARY KEY,
    item_name VARCHAR(150
    hsn_code VARCHAR(10),
    gst_percent DECIMAL(5,2),
	new_mrp decimal(12,2),
	old_mrp DECIMAL(12,2),
	max_stock INT DEFAULT 0,
    min_stock INT DEFAULT 0,
	opening_balance decimal(12,2),
	closing_balance decimal(12,2),
    status TINYINT(1) NOT NULL DEFAULT 1,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
	updated_at TIMESTAMP DEAFULT CURRENT_TIMESTAMP
);

                                                    --- sales master ----------
CREATE TABLE sales (
    sale_id INT AUTO_INCREMENT PRIMARY KEY,
    customer_id INT,
    invoice_no VARCHAR(50),
    sold_at datetime,
    subtotal DECIMAL(12,2),
    cgst DECIMAL(12,2),
    sgst DECIMAL(12,2),
    igst DECIMAL(12,2),
    grand_total DECIMAL(12,2),
    status int   /* mapped with r_enum_values  */
    created_by INT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

                                             -----       sales items table ----------------
CREATE TABLE sale_items (
    id INT AUTO_INCREMENT PRIMARY KEY,
    sale_id INT,
    item_id INT,
    quantity INT,
    rate DECIMAL(10,2),
    hsn_sac_code VARCHAR(10),
    gst_percent DECIMAL(5,2),
    cgst DECIMAL(10,2),
    sgst DECIMAL(10,2),
    igst DECIMAL(10,2),
    total DECIMAL(12,2)
);

                               ----- PURCHASE MODULE ----------------

                               -- purchase master table ------

CREATE TABLE purchases (
    purchase_id INT AUTO_INCREMENT PRIMARY KEY,
    company_id INT,
    vendor_id INT,
    bill_no VARCHAR(50),
    purchase_date DATE,
    subtotal DECIMAL(12,2),
    tax_total DECIMAL(12,2),
    grand_total DECIMAL(12,2),
    payment_status ENUM('PENDING','PAID','PARTIAL'),
    created_by INT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

												--- purchase items table ----
CREATE TABLE purchase_items (
    id INT AUTO_INCREMENT PRIMARY KEY,
    purchase_id INT,
    item_id INT,
    quantity INT,
    rate DECIMAL(10,2),
    gst_percent DECIMAL(5,2),
    gst_amount DECIMAL(10,2),
    total DECIMAL(12,2)
);
